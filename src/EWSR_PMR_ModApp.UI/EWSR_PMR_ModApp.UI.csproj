<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds app.ico into the .exe so desktop shortcuts and Explorer show the icon. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>PMR CM</AssemblyName>
    <Version>1.3.4</Version>
    <AssemblyVersion>1.3.4.0</AssemblyVersion>
    <FileVersion>1.3.4.0</FileVersion>
    <Product>PMR CM</Product>
    <Company>EWSR</Company>
    <Authors>Elliott Williams</Authors>
    <Copyright>Copyright 2026 Elliott Williams</Copyright>
    <Description>Project Motor Racing Mod Manager — drop a zip, it just works.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Include app.ico as a Resource so Window.Icon="Assets/app.ico" resolves via
      pack URI at runtime (WPF Window.Icon needs the file as an embedded resource).
    -->
    <Resource Include="Assets\app.ico"/>
    <!-- In-app toolbar logo (PMR/CM mark on black). -->
    <Resource Include="Assets\logo.png"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EWSR_PMR_ModApp.Core\EWSR_PMR_ModApp.Core.csproj" />
    <!--
      Copy Helper.exe alongside the UI executable.
      ReferenceOutputAssembly="false" — do NOT link Core against Helper.
      OutputItemType="Content" — treat the Helper's primary output as a Content item.
      CopyToOutputDirectory — copy to UI's bin output so the UI can spawn it via AppContext.BaseDirectory.
    -->
    <ProjectReference Include="..\EWSR_PMR_ModApp.Helper\EWSR_PMR_ModApp.Helper.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.5" />
  </ItemGroup>

  <!-- A non-reference executable project copies its apphost/sidecars, but not its managed DLL. -->
  <Target Name="CopyHelperRuntimeAssembly" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\EWSR_PMR_ModApp.Helper\EWSR_PMR_ModApp.Helper.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_HelperRuntimeAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_HelperRuntimeAssembly)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
